# Copy to .env and set values locally. Never commit .env.
GROQ_API_KEY=replace_with_your_key
GROQ_MODEL=openai/gpt-oss-20b
DATABASE_URL=postgresql://sahayak:sahayak@localhost:5433/sahayak
JWT_SECRET_KEY=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24
CHROMA_PATH=./chroma_db
API_URL=http://localhost:8000
SAHAYAK_CPU_THREADS=4
SAHAYAK_METRICS=true
# Enable tracing only when you intend to send prompts and responses to LangSmith.
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=sahayak
